{
  "name": "rbi-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:ts": "vite build",
    "build:locations": "vite build --config vite.locations.config.ts",
    "build:construction-defects": "vite build --config vite.construction-defects.config.ts",
    "build:construction-acceptance": "vite build --config vite.construction-acceptance.config.ts",
    "build:construction-units": "vite build --config vite.construction-units.config.ts",
    "build:construction-v2": "vite build --config vite.construction-v2.config.ts",
    "build:plan-fact": "vite build --config vite.plan-fact.config.ts",
    "build:modules": "npm run build:locations && npm run build:construction-defects && npm run build:construction-acceptance && npm run build:construction-units && npm run build:construction-v2 && npm run build:plan-fact",
    "check:ts": "tsc --noEmit",
    "check:boundaries": "bash _ai/scripts/check-module-boundaries.sh",
    "test:unit": "node --test js/shared/__tests__/*.test.js js/modules/knowledge/__tests__/*.test.js js/modules/quality/features/analytics/__tests__/*.test.js src/modules/plan-fact/domain/*.test.ts",
    "smoke:knowledge": "node _ai/scripts/smoke-knowledge.mjs --reload",
    "smoke:construction-knowledge": "node _ai/scripts/smoke-construction-knowledge.mjs --reload",
    "smoke:plan-fact": "node _ai/scripts/smoke-plan-fact.mjs",
    "smoke:plan-fact-cloud": "node _ai/scripts/smoke-plan-fact-cloud.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
